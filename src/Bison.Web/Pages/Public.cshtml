@page "/{obs?}"
@model Bison.Web.Pages.PublicModel
@using Bison.Core.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("page");
}

@functions{
    int currentCount = 0;
    public int GetHello()
    {
        Console.WriteLine("Hello");
        return currentCount++;
    }
}

<div>
    <h2> Public Timeline </h2>
    @if (Model.Observations != null && Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Message
                        <small>&mdash; @obs.Timestamp</small>
                        <!--<partial name="_likeButton.cshtml" />-->
                        <!--<button Onclick="LikeFunction()">Like</button>-->
                        <form method="post">
                            <input class="submit" type="button" value="like" onclick="LikeFunction()"/>
                        </form>
                        <a href="/ob?id=@obs.PostId">See comments and proposals</a>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
    @{
        ViewData["ObservationCount"] = Model.Observations.Count;
    }
    <partial name="_PaginationPartial" model="Model.CurrentPage" />
</div>

@section Scripts {
    <script>
        function LikeFunction(){
            @GetHello();
            //currentCount++;
            //alert(currentCount);
            //$("button").html('@@GetHello()');
        }
    </script>
}