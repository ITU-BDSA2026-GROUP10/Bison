@page "/ob"
@model Bison.Web.Pages.ObIdModel
@using Bison.Core.Models
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    //var routeName = HttpContext.GetRouteValue("page");
}
<div>
    <h2> Public Timeline </h2>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@ob.Author">@ob.Author</a>
                        </strong>
                        @ob.Message
                        <small>&mdash; @ob.Timestamp</small>
                    </p>
                     @if(SignInManager.IsSignedIn(User) && ob.Author != User.Identity.Name)
                    {   
                        <form asp-page="Public">
                        <fieldset name="writeComment">
                        <legend>Add Commment</legend>
                        <div>
                            <label for="Com">Write your comment here: </label>
                            <input type="text" name="comment" value="" />
                            @Html.ValidationMessage("comment")
                        </div>
                        <div>
                            <input type="submit" value="Share Comment">
                        </div>
                            </fieldset>
                        </form>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>
