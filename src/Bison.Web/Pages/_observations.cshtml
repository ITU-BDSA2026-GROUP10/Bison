<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Post Page</title>
    </head>
    <body>
        @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Message
                        <small>&mdash; @obs.Timestamp</small>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-page="Public" method="post" asp-page-handler="Like" asp-route-id="@obs.PostId"> 
                                <button style="background:#e29494;padding:1%;color:#7e2c2c;" >Save</button>
                                <!--<button style="background:#cc6e6e;padding:5;color:#7e2c2c;" >Save @@heartEmpty</button>-->
                            </form>
                        }
                       
                        <a href="/ob?id=@obs.PostId">See comments and proposals</a>
                        <img src="/uploads/@{@obs.PostId}.png" onerror="this.onerror=null; this.remove();" alt="picture" height="50"/>
                    </p>
                </li>
            }
    </body>
</html>