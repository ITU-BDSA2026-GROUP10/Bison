@page "/obs/{author}"
@model Bison.Web.Pages.UserTimelineModel
@using Microsoft.AspNetCore.Identity
@using Bison.Core.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    <h2> @routeName's Observations </h2>
    @if (SignInManager.IsSignedIn(User) && routeName.ToString() == User.Identity.Name)
    {
      <partial name="_form.cshtml"></partial>
    }

</div>
<div>
    @if (Model.Observations != null && Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@ob.Author">@ob.Author</a>
                        </strong>
                        @ob.Message
                        <small>&mdash; @ob.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
    @{
        ViewData["ObservationCount"] = Model.Observations.Count;
    }
    <partial name="_PaginationPartial" model="Model.CurrentPage" />
</div>
