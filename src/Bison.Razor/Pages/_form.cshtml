<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Post Page</title>
    </head>
    <body>
        <h3>What did you spot today?</h3>
        <form method="post">
            <fieldset>
          <legend>Add observation</legend>
          <div>
            <label for="Obs">Write your observation here: </label>
            <input type="text" name="observation" value="" />
            @Html.ValidationMessage("observation")
          </div>
          <div>
            <label>Email:</label>
            <input type="email" name="email" />
        </div>
          <div>
            <input type="submit" value="Post">
          </div>
            </fieldset>
        </form>
    </body>
</html>