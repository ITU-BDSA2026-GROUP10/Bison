<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"]</title>
    <link href="/css/style.css" rel="stylesheet" type="text/css" />
    <link rel="icon" type="image/png" href="/favicon/favicon.ico">
</head>
<body>
<div class=page>
    <h1><img src="/images/icon1.png" alt="Icon1"/>Bison</h1>
    <div class=navigation>
        @if (User.Identity.IsAuthenticated)
        {
            <div>
                <a href="/@(User.Identity.Name)">My Observations</a> |
                <a href="/">Public Observations</a> |
                <a href="/" >Logout [@(User.Identity.Name)]</a> <!--THIS NEEDS TO BE CHANGED-->
            </div>
        }
        else
        {
            <div>
                <a href="/">Public Observations</a> |
                <a href="/" >Register</a> | <!--THIS NEEDS TO BE CHANGED-->
                <a href="/" >Login</a> <!--THIS NEEDS TO BE CHANGED-->
            </div>
        }
    </div>
    <div class=body>
            @RenderBody()
    </div>
    <div class=footer>
        Bison &mdash; An ASP.NET Application
    </div>
</div>

</body>
@await RenderSectionAsync("Scripts", required: false)
</html>
